# ─────────────────────────────────────────────────────────────
# Production config for docker-compose.prod.yml
# Copy to ".env.prod" and fill in real values. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod
# Generate secrets with:  openssl rand -hex 48
# ─────────────────────────────────────────────────────────────

# Public domain (used for CORS). The app is published via Cloudflare Tunnel,
# so no ports are opened on the server — see DEPLOY.md.
DOMAIN=wqmscloud.com

# Cloudflare Tunnel token: Zero Trust ▸ Networks ▸ Tunnels ▸ <your tunnel>.
# Publishes https://wqmscloud.com with no port forwarding / public IP.
CLOUDFLARE_TUNNEL_TOKEN=paste_your_tunnel_token_here

# PostgreSQL password (used by both the db container and the backend)
DB_PASSWORD=change_me_to_a_strong_password

# JWT secrets — generate two DIFFERENT values: openssl rand -hex 48
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# Internal API secret (live-data endpoints): openssl rand -hex 32
INTERNAL_API_SECRET=change_me

# MQTT — HiveMQ Cloud (managed broker). Remote sensors AND this backend both
# connect OUTBOUND to it, so no inbound ports are needed. Get these from your
# HiveMQ Cloud cluster (Overview = host/port, Access Management = credentials).
MQTT_BROKER_URL=mqtts://YOUR-CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password
MQTT_TOPIC=aquamind/+

# Email notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@aquamind.local

# Frontend
VITE_REFRESH_INTERVAL=60000
