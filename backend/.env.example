# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://petronas:secure_password_change_me@localhost:5432/petronas_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=petronas-monitoring-api
JWT_AUDIENCE=petronas-monitoring-client

# Sensor Configuration
# Timezone offset for sensors (hours ahead of UTC)
# Malaysia is UTC+8, so set to 8
# If sensors send UTC, set to 0
SENSOR_TIMEZONE_OFFSET=8
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# MQTT Broker (Optional - Week 8)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=petronas
MQTT_PASSWORD=secure_mqtt_password

# FastAPI Service URL (Week 7)
FASTAPI_SERVICE_URL=http://localhost:8000

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@petronas.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Report Generation
REPORTS_DIR=./reports
