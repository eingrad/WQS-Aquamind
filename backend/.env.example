# Server Configuration
NODE_ENV=development
PORT=5001
API_PREFIX=/api

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://aquamind:secure_password_change_me@localhost:5433/aquamind_db

# Redis
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_TTL=3600

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-separate-refresh-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=aquamind-api
JWT_AUDIENCE=aquamind-client

# Sensor Configuration
# Timezone offset for sensors (hours ahead of UTC)
# Malaysia is UTC+8, so set to 8
# If sensors send UTC, set to 0
SENSOR_TIMEZONE_OFFSET=8
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# MQTT Broker (HiveMQ Cloud or local Mosquitto)
MQTT_BROKER_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC=aquamind/+

# Internal API Secret (for MQTT/generator scripts calling live data POST endpoints)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=change_me_generate_a_random_hex_string

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@aquamind.local

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Report Generation
REPORTS_DIR=./reports
